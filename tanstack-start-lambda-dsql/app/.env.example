# Local default: file-backed PGlite, no Docker required.
PGLITE_DATA_DIR=./.data/todos
# PostgreSQL instead of PGlite:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todos
# Aurora DSQL (takes precedence over DATABASE_URL):
# DSQL_HOST=your-cluster.dsql.ap-northeast-1.on.aws
# DSQL_USER=admin
# AWS_REGION=ap-northeast-1
